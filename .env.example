# ==============================================================
# Lottery12KH Environment Configuration Example (Placeholders Only)
# Copy this file to .env and replace placeholder values locally.
# NEVER commit real passwords, secrets, or .env files to GitHub.
# ==============================================================

# Backend server port (Game Page + Shared Backend defaults to 3001 locally)
PORT=3001

# Optional comma-separated allowed CORS origins for production (e.g. Cloudflare Pages domains)
# Example: ALLOWED_ORIGINS="https://lottery12kh-game.pages.dev,https://lottery12kh-admin.pages.dev"
ALLOWED_ORIGINS=""

# Optional custom state file path (used for backups or isolated automated tests)
# STATE_FILE_PATH="./data/lottery_server_state.json"

# Frontend API Base URL (leave empty in local VS Code dev to use Vite proxy / same-origin)
# In Cloudflare Pages production builds, set this to your HTTPS backend URL:
# Example: VITE_API_BASE_URL="https://api.yourdomain.com"
VITE_API_BASE_URL=""

# Optional Frontend WebSocket URL (derived automatically from VITE_API_BASE_URL if omitted)
# Example: VITE_WS_URL="wss://api.yourdomain.com/ws"
VITE_WS_URL=""
